{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd backend && pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "cd backend && gunicorn core.wsgi:application --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/health"
  }
}