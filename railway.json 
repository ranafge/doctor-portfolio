{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python manage.py collectstatic --noinput --settings=core.prod_settings"
  },
  "deploy": {
    "startCommand": "python manage.py migrate --settings=core.prod_settings && gunicorn core.wsgi:application --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/health"
  }
}